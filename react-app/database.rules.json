{
  "rules": {
    ".read": false,
    ".write": false,

    "posts": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt", "publishedAt"]
    },

    "blogCategories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "highlights": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "views": {
      ".read": "auth != null",
      "$postId": {
        "$viewId": {
          ".write": true,
          ".validate": "newData.hasChildren(['timestamp'])"
        }
      }
    }
  }
}
